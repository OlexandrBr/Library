@model Book

<h1>Додати книгу</h1>

<form asp-action="Create" method="post">
    <label asp-for="Title">Назва</label>
    <input asp-for="Title" />
    <span asp-validation-for="Title"></span>

    <label asp-for="Year">Рік видання</label>
    <input asp-for="Year" />
    <span asp-validation-for="Year"></span>

    <label asp-for="AuthorId">Автор</label>
    <select asp-for="AuthorId" asp-items="ViewBag.Authors"></select>

    <button type="submit">Зберегти</button>
</form>
