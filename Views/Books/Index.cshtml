@model List<Book>

<h1>Книги</h1>

<table>
    <tr>
        <th>Назва</th>
        <th>Рік видання</th>
        <th>Автор</th>
        <th>Країна</th>
        <th></th>
    </tr>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Title</td>
            <td>@book.Year</td>
            <td>@book.Author?.Name</td>
            <td>@book.Author?.Country</td>
            <td>
                <form asp-action="Delete" asp-route-id="@book.Id" method="post">
                    <button type="submit" class="delete">Видалити</button>
                </form>
            </td>
        </tr>
    }
</table>
